# StreamPulse frontend — example environment
#
# Copy to .env.local and fill in. Never commit a filled-in copy.

# Base URL the browser calls for the StreamPulse API.
# Leave blank to use the same origin the app is served from.
VITE_API_BASE_URL=

# ── Playwright E2E only ───────────────────────────────────────────────────────
# The e2e suite can redirect UI traffic at a specific deployment instead of
# whatever the built frontend points to. Each var takes a full base URL
# (scheme + host, no trailing path), e.g. https://your-service.example.com
#
# Any var left unset means "don't rewrite" — that request passes through
# untouched, so the suite still runs with no staging config at all.
STAGING_STREAMPULSE_URL=
STAGING_INTELAI_URL=
STAGING_DOCINTEL_URL=
STAGING_AGENTKIT_URL=
STAGING_RAGEVAL_URL=
STAGING_VOICEFLOW_URL=

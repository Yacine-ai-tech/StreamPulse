{
  "name": "StreamPulse Ingest",
  "version": 1,
  "description": "Send JSON payloads directly to StreamPulse Webhook for classification and ingestion.",
  "defaults": {
    "name": "StreamPulse"
  },
  "inputs": ["main"],
  "outputs": ["main"],
  "properties": [
    {
      "displayName": "Method",
      "name": "method",
      "type": "options",
      "options": [
        {
          "name": "POST",
          "value": "POST"
        }
      ],
      "default": "POST",
      "description": "The HTTP method to use"
    },
    {
      "displayName": "URL",
      "name": "url",
      "type": "string",
      "default": "https://streampulse.ysiddo-ai-projects.app/webhook/ingest",
      "description": "StreamPulse Webhook URL"
    },
    {
      "displayName": "Send Body",
      "name": "sendBody",
      "type": "boolean",
      "default": true,
      "description": "Whether to send a JSON body"
    },
    {
      "displayName": "Body Parameters",
      "name": "bodyParameters",
      "type": "fixedCollection",
      "displayOptions": {
        "show": {
          "sendBody": [true]
        }
      },
      "typeOptions": {
        "multipleValues": true
      },
      "placeholder": "Add Parameter",
      "default": {},
      "options": [
        {
          "name": "parameters",
          "displayName": "Parameter",
          "values": [
            {
              "displayName": "Name",
              "name": "name",
              "type": "string",
              "default": "data"
            },
            {
              "displayName": "Value",
              "name": "value",
              "type": "string",
              "default": "={{ $json }}"
            }
          ]
        }
      ]
    }
  ]
}

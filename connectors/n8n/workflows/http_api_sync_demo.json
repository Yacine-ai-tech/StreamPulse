{
  "name": "HTTP API Sync Demo",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "name": "15-Min Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://api.mock-crm.com/v1/recent-tickets",
        "method": "GET",
        "authentication": "headerAuth"
      },
      "name": "Fetch CRM Tickets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.STREAMPULSE_API_URL || 'http://localhost:8000' }}/ingest/json",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "crm_sync"
            },
            {
              "name": "data",
              "value": "={{ $json }}"
            }
          ]
        },
        "options": {}
      },
      "name": "StreamPulse Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    }
  ],
  "connections": {
    "15-Min Trigger": {
      "main": [
        [
          {
            "node": "Fetch CRM Tickets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch CRM Tickets": {
      "main": [
        [
          {
            "node": "StreamPulse Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}

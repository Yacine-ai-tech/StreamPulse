# StreamPulse configuration. Copy to `.env` and fill in what you use. Every value is read from
# the environment; nothing is hardcoded. Empty means "unset". Never commit a filled-in copy.

# ─── Server ──────────────────────────────────────────────────────────────────
# Set to "production" to refuse to start without an explicit WEBHOOK_SECRET.
ENV=
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
# Python logging format string.
# LOG_FORMAT=
# Message language for API strings (en, fr). Read from LANG, then LANGUAGE.
LANGUAGE=en
# Comma-separated browser origins allowed to call the API. "*" allows any (development only).
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ─── Access control ──────────────────────────────────────────────────────────
# When true, every API route except health, readiness, docs and static assets requires an
# internal token (X-StreamPulse-Internal-Token, X-Internal-Token or Bearer).
REQUIRE_INTERNAL_TOKEN=false
# Token(s) accepted when REQUIRE_INTERNAL_TOKEN=true. Any one is enough; the alternates let
# one token be shared across several services.
STREAMPULSE_INTERNAL_TOKEN=
INTERNAL_TOKEN=
OMNIINTEL_INTERNAL_TOKEN=
# Secret presented in X-Admin-Token to read or replay across every visitor session.
ADMIN_TOKEN=
# When true (default), history, SSE and replay are limited to the caller's own session
# (X-Demo-Session-Id header, or ?session_id= for SSE). Records from signed webhooks and
# integrations carry no session and stay visible to everyone. Anonymous isolation, not auth.
DEMO_SESSION_SCOPING=true

# ─── Webhooks and integrations ───────────────────────────────────────────────
# Shared secret for HMAC-SHA256 verification of X-Signature-256 on /webhook/{source}.
# Generate a long random value. Required when ENV=production; otherwise a random value is
# generated at start (signatures from other systems then cannot match).
WEBHOOK_SECRET=
# Base URL of DocIntel, used by /webhook/{source}/with-vision (image classification).
DOCINTEL_URL=http://localhost:8001
# Token sent to DocIntel if it requires one.
DOCINTEL_INTERNAL_TOKEN=
# Optional destination that receives every ingested batch as
# {"source", "schema_type", "data": [...]}. Empty disables forwarding.
EXTERNAL_WEBHOOK_URL=
# Value of "schema_type" in the forwarded envelope.
EXTERNAL_WEBHOOK_SCHEMA_TYPE=kpi_metrics
# Bearer token for the destination above. Sent only when set; this service's own internal
# token is never forwarded.
EXTERNAL_WEBHOOK_TOKEN=
# n8n instance to connect to (base URL and API key).
N8N_BASE_URL=
N8N_API_KEY=

# ─── Storage ─────────────────────────────────────────────────────────────────
# Postgres connection URL for the KPI store. Empty uses a local SQLite file.
POSTGRES_URL=
# Maximum pooled Postgres connections (default 50).
PG_POOL_MAX_SIZE=50
# Persist embeddings and classifications in pgvector (needs Postgres with the vector
# extension). Default false.
ENABLE_PGVECTOR=false
# DuckDB analytics (trends, domain summaries). Default false.
ENABLE_DUCKDB=false
# DuckDB file path.
DUCKDB_PATH=streampulse_analytics.duckdb
# Seconds between analytics refreshes when DuckDB is enabled (default 900).
ANALYTICS_REFRESH_INTERVAL_SECONDS=900

# ─── Live fan-out across several instances ───────────────────────────────────
# redis (default) or kafka. Without the matching URL below, events stay on the local instance.
MESSAGE_BROKER=redis
REDIS_URL=
KAFKA_BROKER_URL=

# ─── Classifier ──────────────────────────────────────────────────────────────
# Minimum keyword confidence (0.4 + 0.2 per hit) to answer without the embedding tier.
CLASSIFIER_KEYWORD_THRESHOLD=0.55
# Minimum embedding similarity to commit instead of deferring to the LLM tier.
CLASSIFIER_EMBEDDING_THRESHOLD=0.65
# Confidence value recorded for answers decided by the LLM tier.
CLASSIFIER_LLM_CONFIDENCE=0.7
# Cache decisions by content hash.
CLASSIFIER_ENABLE_CACHE=true
# 1 enables the embedding and LLM tiers; 0 makes the classifier keyword-only.
STREAMPULSE_HYBRID_LLM=1
# Path to a domain-pack JSON ({domain: [prototype phrases]}). Empty uses the bundled pack.
STREAMPULSE_DOMAIN_PACK=
# Seconds to wait for one LLM classification call (default 5).
CLASSIFIER_LLM_TIMEOUT_SECONDS=5

# ─── LLM tier ────────────────────────────────────────────────────────────────
# LiteLLM model identifiers in provider/model form.
LLM_DEFAULT=groq/openai/gpt-oss-120b
LLM_JUDGE=groq/openai/gpt-oss-120b
# Model used when the primary call fails authentication.
LLM_JUDGE_FALLBACK=
# Model used when the primary call is rate-limited, and as the primary when only a Gemini key
# is configured. Needs GEMINI_API_KEY. Default gemini/gemini-2.5-flash.
LLM_JUDGE_FAILOVER=gemini/gemini-2.5-flash
# Provider keys; only providers you reference above are needed. <PROVIDER>_API_KEYS (comma
# or whitespace separated) or extra <PROVIDER>_API_KEY_<suffix> variables are rotated
# round-robin; <PROVIDER>_KEY_SLOTS (for example "1,3") pins this deployment to a subset.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Embeddings (tier 2) ─────────────────────────────────────────────────────
# Embedding model identifier.
STREAMPULSE_EMBED_MODEL=BAAI/bge-m3
# remote (default) calls EMBEDDING_ENDPOINT; local loads the model in this process.
INFERENCE_MODE=remote
# Host for remote embeddings. A huggingface.co URL is called in its native shape; any other
# URL receives POST {url}/embed with {"texts": [...], "model": "..."} and returns
# {"embeddings": [[...], ...]}.
EMBEDDING_ENDPOINT=
# Bearer token for the embedding host.
EMBED_TOKEN=
# A host that is still starting answers 503. Total seconds to keep polling it (default 420)...
INFERENCE_WAKE_TIMEOUT=420
# ...and seconds between polls (default 15).
INFERENCE_RETRY_DELAY=15

# ─── Telemetry ───────────────────────────────────────────────────────────────
# One anonymous startup ping (service name, version, random install id). Disable with
# TELEMETRY_OPT_OUT=true or DO_NOT_TRACK=1.
TELEMETRY_OPT_OUT=false
DO_NOT_TRACK=
# Override the ping destination. Empty uses the project default.
TELEMETRY_URL=

# ─── Frontend build (Vite) ───────────────────────────────────────────────────
# API base URL when the dashboard is hosted separately. Empty = same origin.
VITE_API_BASE_URL=
# Dev server proxy target.
VITE_PROXY_TARGET=http://localhost:8004

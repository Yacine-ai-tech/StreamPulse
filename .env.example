# StreamPulse — Real-time data pipeline
# Copy to .env and fill in your real keys

# Database Configuration
POSTGRES_URL=sqlite:///./streampulse.db          # SQLite (default) or PostgreSQL for production
REDIS_URL=                                       # Optional Redis for message broker
KAFKA_BROKER_URL=                                # Optional Kafka for message broker
MESSAGE_BROKER=sqlite                            # sqlite|redis|kafka

# LLM Models
LLM_DEFAULT=groq/llama-3.3-70b-versatile
LLM_JUDGE=anthropic/claude-haiku-4-5
STREAMPULSE_HYBRID_LLM=1                         # Enable LLM escalation for classifier

# API Keys
GROQ_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Webhook Security
WEBHOOK_SECRET=change_me

# Service Integration
DOCINTEL_URL=http://localhost:8001              # For /webhook/{src}/with-vision composition

# External Integrations
EXTERNAL_WEBHOOK_URL=
EXTERNAL_WEBHOOK_SCHEMA_TYPE=

# n8n Integration (Public Integration Layer Only)
# Note: These are for connecting TO an external n8n instance
N8N_BASE_URL=https://your-n8n-instance.example.com
N8N_API_KEY=your_n8n_api_key_if_needed

# Classifier Configuration
CLASSIFIER_KEYWORD_THRESHOLD=0.7                # Confidence threshold for keyword classification
CLASSIFIER_EMBEDDING_THRESHOLD=0.5              # Confidence threshold for embedding classification
CLASSIFIER_LLM_CONFIDENCE=0.7                   # Confidence value for LLM fallback classification
CLASSIFIER_ENABLE_CACHE=true                    # Enable content hash caching for performance
STREAMPULSE_EMBED_MODEL=BAAI/bge-large-en-v1.5   # Embedding model for vector similarity

# Storage Configuration
ENABLE_PGVECTOR=false                          # Enable pgvector for embedding cache (requires pgvector extension)
ENABLE_DUCKDB=false                            # Enable DuckDB for analytics queries
DUCKDB_PATH=streampulse_analytics.duckdb        # Path to DuckDB database file

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:8004,http://localhost:3000
OMNIINTEL_INTERNAL_TOKEN=
REQUIRE_INTERNAL_TOKEN=false

# When true (default), /pipeline/history, /live/sse, and /pipeline/replay scope to the
# calling browser's X-Demo-Session-Id (or ?session_id= for the SSE stream, since EventSource
# can't set headers) plus any session-less data — real external webhooks/n8n/CRM sources
# never send this and stay globally visible, which is the point of a public ingestion demo.
# A visitor testing ingestion through the frontend UI only sees their own test events.
# Anonymous demo isolation, not production auth.
DEMO_SESSION_SCOPING=true

# Logging & Telemetry
LOG_LEVEL=INFO
# Anonymous startup ping (service name + a random, locally-generated, non-hardware-derived
# Where the ping goes. Defaults to the upstream StreamPulse project's adoption-tracking
# endpoint; override or leave OPT_OUT=true if you don't want to report to it.

# Playwright E2E testing credentials
E2E_ADMIN_PASSWORD=change_me_e2e_password
